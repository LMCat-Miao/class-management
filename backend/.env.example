# 复制本文件为 .env 后填写真实值：
#   copy .env.example .env
#
# 注意：.env 已加入 .gitignore，请勿提交到 Git。

# ---------- 运行环境 ----------
# development：本地开发（可省略 SECRET_KEY，将使用代码内开发默认值）
# production：生产部署（必须设置强随机 SECRET_KEY，且不能等于开发默认值）
APP_ENV=development

# ---------- MySQL（必填：至少配置 DB_PASSWORD）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写自己的密码
DB_NAME=class_management

# ---------- JWT ----------
# 开发环境：可不设置 SECRET_KEY（使用开发默认值，仅限本地）。
# 生产环境：必须取消注释并填写强随机字符串（建议长度 >= 32），例如：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 切勿把真实 SECRET_KEY 提交到 Git，也不要在生产使用开发默认值。
# SECRET_KEY=

# ---------- 资源上传（可选；相对 backend 工作目录）----------
# UPLOAD_DIR=uploads
# UPLOAD_MAX_BYTES=52428800

# ---------- AI PDF 解析（可选；读入内存上限，默认 10MB）----------
# AI_PDF_MAX_BYTES=10485760
